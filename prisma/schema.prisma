datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
  previewFeatures = ["driverAdapters"]
}

enum Role {
  SUPERADMIN
  ADMIN
  FACULTY
  STUDENT
}

enum Permission {
  CREATE_COURSE
  EDIT_COURSE
  DELETE_COURSE
  REGISTER_STUDENT
  REMOVE_STUDENT
  CREATE_FEES
  EDIT_FEES
  DELETE_FEES
  MANAGE_GRADES
  VIEW_REPORTS
  CREATE_ADMIN
  EDIT_ADMIN
  DELETE_ADMIN
  MANAGE_ADMISSIONS
  VIEW_ADMISSION_DASHBOARD
  MANAGE_FEES
}

enum ApprovalStatus {
  PENDING
  APPROVED
  REJECTED
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  staffId       String?   @unique  // For faculty/admin staff identification
  matricNo      String?   @unique  // For student matric number
  emailVerified DateTime?
  image         String?
  password      String?
  role          Role      @default(STUDENT)
  isActive      Boolean   @default(true)
  lastLogin     DateTime?

  // Student academic profile (optional; populated for enrolled students)
  level         String?   // e.g. "100", "200"
  programmeId   String?
  programme     Programme? @relation(fields: [programmeId], references: [id])
  departmentId  String?
  department    Department? @relation(fields: [departmentId], references: [id])
  facultyId     String?
  faculty       Faculty?  @relation(fields: [facultyId], references: [id])
  
  // Permissions can be simple string array or structured relation
  permissions   String[]  @default([]) // e.g. ["users:read", "users:write"]

  accounts      Account[]
  sessions      Session[]
  
  courses       Course[]  @relation("Enrollments")
  
  notifications Notification[]
  payments      Payment[]
  grades        Grade[]

  // Faculty specific relation (courses taught)
  coursesTaught Course[] @relation("FacultyCourses")
  
  // Admin permissions (Structured)
  assignedPermissions   AdminPermission[]
  
  // Superadmin created admins
  createdAdmins User[] @relation("SuperadminAdmins")
  createdBy     User? @relation("SuperadminAdmins", fields: [createdById], references: [id])
  createdById   String?
  
  // Approval workflows
  approvalsCreated    ApprovalRequest[] @relation("CreatedBy")
  approvalsApproved   ApprovalRequest[] @relation("ApprovedBy")
  
  // Audit Logs
  auditLogs     AuditLog[] @relation("Performer")
  targetLogs    AuditLog[] @relation("Target")

  // PRD-aligned portal back-relations
  courseRegistrations CourseRegistration[]
  results             Result[]
  invoices            Invoice[]
  receipts            Receipt[]
  announcements       Announcement[] @relation("AnnouncementAuthor")
  news                News[]         @relation("NewsAuthor")
  supportTickets      SupportTicket[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model FeeStructure {
  id          String   @id @default(cuid())
  name        String   // e.g., "Acceptance Fee", "School Fees"
  amount      Float
  level       String   // e.g., "100", "200", "ALL"
  currency    String   @default("NGN")
  priority    Int      // 1 = Must pay first, 2 = Second, etc.
  dueDate     DateTime?
  
  isActive    Boolean  @default(true)
  
  // Relationship for academic year or session could be added later
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([name, level])
}

model AuditLog {
  id          String   @id @default(cuid())
  action      String   // e.g. "CREATE_ADMIN", "UPDATE_PERMISSION"
  entity      String   // e.g. "User", "Course"
  entityId    String?
  details     Json?    // details about the change

  performerId String
  performer   User     @relation("Performer", fields: [performerId], references: [id])
  
  targetUserId String?
  targetUser   User?    @relation("Target", fields: [targetUserId], references: [id])

  createdAt   DateTime @default(now())
}

model Account {
  id                 String  @id @default(cuid())
  userId             String
  type               String
  provider           String
  providerAccountId  String
  refresh_token      String?  @db.Text
  access_token       String?  @db.Text
  expires_at         Int?
  token_type         String?
  scope              String?
  id_token           String?  @db.Text
  session_state      String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Course {
  id        String   @id @default(cuid())
  name      String
  code      String   @unique
  department String?
  level     String?  // e.g. "100", "200"
  price     Float    @default(0.0) // Course-specific fee if applicable
  credits   Int      @default(3)   // Course credit units
  
  facultyId String
  faculty   User     @relation("FacultyCourses", fields: [facultyId], references: [id])
  
  students  User[]   @relation("Enrollments")
  grades    Grade[]
  
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model DepartmentFee {
  id         String   @id @default(cuid())
  department String   @unique
  amount     Float
  updatedAt  DateTime @updatedAt
}

model Grade {
  id        String  @id @default(cuid())
  studentId String
  student   User    @relation(fields: [studentId], references: [id])
  courseId  String
  course    Course  @relation(fields: [courseId], references: [id])
  grade     String
}

model Payment {
  id            String   @id @default(cuid())
  studentId     String
  student       User     @relation(fields: [studentId], references: [id])
  amount        Float
  currency      String   @default("NGN")
  status        String   // "PENDING", "COMPLETED", "FAILED"
  provider      String   // "flutterwave", "paystack"
  transactionId String?  @unique // ID from the provider
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  title     String
  message   String
  read      Boolean  @default(false)
  createdAt DateTime @default(now())
}

model AdminPermission {
  id        String   @id @default(cuid())
  adminId   String
  admin     User     @relation(fields: [adminId], references: [id], onDelete: Cascade)
  permission Permission
  grantedAt DateTime @default(now())
  grantedBy String   // Superadmin ID who granted this
  
  @@unique([adminId, permission])
}

model ApprovalRequest {
  id            String   @id @default(cuid())
  type          String   // "COURSE_CREATE", "STUDENT_REGISTER", "FEES_CREATE", etc.
  status        ApprovalStatus @default(PENDING)
  
  createdById   String
  createdBy     User     @relation("CreatedBy", fields: [createdById], references: [id])
  
  approvedById  String?
  approvedBy    User?    @relation("ApprovedBy", fields: [approvedById], references: [id])
  
  data          String   @db.Text // JSON data for the request
  rejectionReason String?
  
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model Faculty {
  id        String   @id @default(cuid())
  name      String   @unique
  acronym   String   @unique
  departments Department[]
  programmes Programme[]
  users     User[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Department {
  id        String   @id @default(cuid())
  name      String
  acronym   String
  facultyId String
  faculty   Faculty  @relation(fields: [facultyId], references: [id], onDelete: Cascade)
  programmes Programme[]
  users     User[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([facultyId, acronym])
}

model Admission {
  id        String   @id @default(cuid())
  trackingId String  @unique // Unique ID for applicant to track
  firstName String
  lastName  String
  email     String
  phone     String
  dateOfBirth DateTime
  gender    String
  address   String
  state     String
  country   String

  previousSchool String
  previousGrade  String
  transcriptUrl  String? // Base64 string or URL
  
  program   String // e.g. "Computer Science"
  password  String? // New field for applicant password

  emergencyContactName String
  emergencyContactPhone String
  emergencyContactRelation String
  
  status    ApprovalStatus @default(PENDING)
  submittedAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ---------------------------------------------------------------------------
// PRD-aligned core academic / portal entities (additive, non-breaking)
// Status fields are stored as String with documented allowed values from the
// PRD (e.g. application statuses, payment statuses) to avoid enum churn while
// keeping data integrity enforced at the application layer.
// ---------------------------------------------------------------------------

model Programme {
  id        String   @id @default(cuid())
  name      String
  code      String   @unique
  facultyId String
  faculty   Faculty  @relation(fields: [facultyId], references: [id], onDelete: Cascade)
  departmentId String?
  department   Department? @relation(fields: [departmentId], references: [id])
  degreeType String // BSc, MSc, PhD, Diploma
  duration   String // "4 years"
  studyLevel String @default("Undergraduate") // Undergraduate | Postgraduate
  entryRequirements String
  description String
  careerOpportunities String?
  tuitionInfo String?
  isActive  Boolean  @default(true)
  users     User[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([facultyId, code])
  @@index([facultyId])
  @@index([departmentId])
}

model AcademicSession {
  id        String   @id @default(cuid())
  name      String   @unique // e.g. "2024/2025"
  isCurrent Boolean  @default(false)
  startDate DateTime
  endDate   DateTime
  semesters Semester[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Semester {
  id        String   @id @default(cuid())
  name      String   // "First", "Second", "Rain"
  sessionId String
  session   AcademicSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  startDate DateTime
  endDate   DateTime
  registrationStart DateTime?
  registrationEnd   DateTime?
  examStart DateTime?
  examEnd   DateTime?
  isCurrent Boolean @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([sessionId, name])
  @@index([sessionId])
}

model CourseRegistration {
  id        String   @id @default(cuid())
  studentId String
  student   User     @relation(fields: [studentId], references: [id], onDelete: Cascade)
  courseId  String // references Course.id (String FK to avoid altering Course model)
  sessionId String
  semesterId String
  type      String   @default("COMPULSORY") // COMPULSORY | ELECTIVE
  status    String   @default("ACTIVE") // ACTIVE | DROPPED | APPROVED
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([studentId, courseId, sessionId, semesterId])
  @@index([studentId])
  @@index([sessionId, semesterId])
}

model Result {
  id        String   @id @default(cuid())
  studentId String
  student   User     @relation(fields: [studentId], references: [id], onDelete: Cascade)
  courseId  String
  sessionId String
  semesterId String
  grade     String   // A, B, C, D, E, F
  gradePoints Float
  creditUnits Int
  status    String   @default("DRAFT") // DRAFT | SUBMITTED | APPROVED | PUBLISHED
  publishedAt DateTime?
  approvedBy String?
  approvedAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([studentId, courseId, sessionId, semesterId])
  @@index([studentId])
  @@index([status])
}

model Invoice {
  id        String   @id @default(cuid())
  studentId String
  student   User     @relation(fields: [studentId], references: [id], onDelete: Cascade)
  sessionId String?
  semesterId String?
  amount    Float
  currency  String   @default("NGN")
  description String
  dueDate   DateTime?
  status    String   @default("UNPAID") // UNPAID | PARTIAL | PAID | CANCELLED
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([studentId])
}

model Receipt {
  id        String   @id @default(cuid())
  paymentId String   @unique
  studentId String
  student   User     @relation(fields: [studentId], references: [id], onDelete: Cascade)
  amount    Float
  currency  String   @default("NGN")
  reference String
  issuedAt  DateTime @default(now())

  @@index([studentId])
}

model Announcement {
  id        String   @id @default(cuid())
  title     String
  content   String
  imageUrl  String?
  audience  String   @default("GENERAL") // GENERAL | FACULTY | DEPARTMENT | PROGRAMME | STUDENT
  facultyId String?
  departmentId String?
  programmeId String?
  targetUserId String?
  publishAt DateTime @default(now())
  expireAt  DateTime?
  createdById String
  createdBy User     @relation("AnnouncementAuthor", fields: [createdById], references: [id])
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([audience])
}

model News {
  id        String   @id @default(cuid())
  title     String
  slug      String   @unique
  content   String
  excerpt   String?
  imageUrl  String?
  category  String   @default("General")
  authorId  String?
  author    User?    @relation("NewsAuthor", fields: [authorId], references: [id])
  published Boolean  @default(false)
  publishedAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([published])
}

model Event {
  id        String   @id @default(cuid())
  title     String
  description String
  category  String   @default("General")
  venue     String?
  startDate DateTime
  endDate   DateTime?
  imageUrl  String?
  published Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([published])
}

model SupportTicket {
  id        String   @id @default(cuid())
  ticketId  String   @unique
  studentId String
  student   User     @relation(fields: [studentId], references: [id], onDelete: Cascade)
  category  String
  subject   String
  description String
  status    String   @default("OPEN") // OPEN | IN_PROGRESS | WAITING_FOR_USER | RESOLVED | CLOSED
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([studentId])
  @@index([status])
}

model Document {
  id        String   @id @default(cuid())
  ownerId   String // student or applicant id
  ownerType String   @default("STUDENT") // STUDENT | APPLICANT
  type      String // ADMISSION_LETTER | REGISTRATION_SLIP | RECEIPT | RESULT | FORM
  filename  String
  storageKey String  // path outside public web root
  mimeType  String
  size      Int
  accessible Boolean @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([ownerId])
}

model TimetableEntry {
  id        String   @id @default(cuid())
  courseId  String
  courseCode String
  courseTitle String
  lecturer  String?
  day       String // MONDAY..SUNDAY
  startTime String // HH:mm
  endTime   String // HH:mm
  venue     String?
  sessionId String
  semesterId String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([sessionId, semesterId])
}

model Exam {
  id        String   @id @default(cuid())
  courseId  String
  courseCode String
  courseTitle String
  date      DateTime
  startTime String
  endTime   String
  venue     String?
  instructions String?
  sessionId String
  semesterId String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([sessionId, semesterId])
}
